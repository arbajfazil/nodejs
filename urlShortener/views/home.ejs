<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Home Page</title>
    <style>
    
* {
    margin: 0;
    padding: 0;
    box-sizing: border-box;
}

body {
    min-height: 100vh;
    padding: 40px 20px;

    font-family: "Segoe UI", Arial, sans-serif;
    background: linear-gradient(135deg, #667eea, #764ba2);
    color: #222;
}

/* Main Heading */
h1 {
    text-align: center;
    color: white;

    font-size: clamp(2rem, 5vw, 3.2rem);
    margin-bottom: 25px;

    letter-spacing: 1px;
}

/* Generated URL */
body > p {
    width: min(700px, 100%);
    margin: 0 auto 25px;

    padding: 14px 18px;

    background: white;
    color: #4f46e5;

    border-radius: 10px;

    font-weight: 600;
    text-align: center;

    overflow-wrap: anywhere;

    box-shadow: 0 8px 20px rgba(0, 0, 0, 0.15);
}

/* Form Container */
body > div {
    width: min(700px, 100%);
    margin: 0 auto 30px;

    background: rgba(255, 255, 255, 0.96);

    padding: 30px;

    border-radius: 18px;

    box-shadow: 0 15px 35px rgba(0, 0, 0, 0.2);
}

/* Form */
form {
    display: flex;
    flex-direction: column;
    gap: 12px;
}

label {
    font-size: 1rem;
    font-weight: 600;
    color: #333;
}

/* Input */
input {
    width: 100%;

    padding: 14px 16px;

    border: 2px solid #ddd;
    border-radius: 10px;

    outline: none;

    font-size: 1rem;

    transition: 0.3s;
}

input:focus {
    border-color: #667eea;

    box-shadow: 0 0 0 3px rgba(102, 126, 234, 0.15);
}

/* Generate Button */
button {
    width: 100%;

    padding: 14px;

    border: none;
    border-radius: 10px;

    background: linear-gradient(135deg, #667eea, #764ba2);

    color: white;

    font-size: 1rem;
    font-weight: 600;

    cursor: pointer;

    transition: 0.3s;
}

button:hover {
    transform: translateY(-2px);

    box-shadow: 0 8px 18px rgba(102, 126, 234, 0.4);
}

button:active {
    transform: translateY(0);
}


/* =========================
   URL TABLE
   ========================= */

body > div:last-child {
    width: min(1000px, 100%);
    margin: 0 auto;

    padding: 0;

    background: white;

    border-radius: 18px;

    overflow-x: auto;

    box-shadow: 0 15px 35px rgba(0, 0, 0, 0.2);
}

table {
    width: 100%;

    min-width: 650px;

    border-collapse: collapse;

    overflow: hidden;
}

/* Table Header */
thead {
    background: linear-gradient(135deg, #667eea, #764ba2);
    color: white;
}

th {
    padding: 16px 14px;

    font-size: 0.95rem;
    font-weight: 600;

    text-align: left;
}

/* Table Data */
td {
    padding: 15px 14px;

    border-bottom: 1px solid #eee;

    font-size: 0.95rem;

    color: #444;
}

/* Alternate Rows */
tbody tr:nth-child(even) {
    background: #f7f8ff;
}

/* Hover Row */
tbody tr:hover {
    background: #eef0ff;
    transition: 0.2s;
}

/* Short ID */
td:nth-child(2) {
    color: #5b5ce2;
    font-weight: 600;
}

/* Redirect URL */
td:nth-child(3) {
    max-width: 350px;

    overflow-wrap: anywhere;
    word-break: break-word;
}

/* Click Count */
td:nth-child(4) {
    font-weight: 600;
    color: #764ba2;
}


/* =========================
   TABLET
   ========================= */

@media (max-width: 700px) {

    body {
        padding: 30px 15px;
    }

    body > div {
        padding: 22px;
    }

    th,
    td {
        padding: 12px 10px;
    }
}


/* =========================
   MOBILE
   ========================= */

@media (max-width: 500px) {

    body {
        padding: 25px 12px;
    }

    h1 {
        font-size: 2rem;
        margin-bottom: 20px;
    }

    body > p {
        font-size: 0.9rem;
        padding: 12px;
    }

    body > div {
        padding: 20px;
        border-radius: 14px;
    }

    input,
    button {
        padding: 13px;
        font-size: 0.95rem;
    }

    table {
        min-width: 600px;
    }
}


/* =========================
   VERY SMALL SCREEN
   ========================= */

@media (max-width: 350px) {

    body {
        padding: 20px 8px;
    }

    h1 {
        font-size: 1.7rem;
    }

    body > div {
        padding: 16px;
    }
}


    </style>
</head>
<body>
    <h1>URL Shortner</h1>
    <% if (locals.id) { %>
      <p>Short Url Generated : http://localhost:8001/<%= id %> </p>
    <% } %>
     
    <div>
        <form method="post" action="/url">
            <label>Past Your Link : </label>
            <input type="text" name="url" placeholder="https://example.com">
            <button type="submit">Generate</button>
        </form>
    </div>
    <div>
        <% if (locals.urls) { %>
         <table>
            <thead>
                <th>S . no</th>
                <th>ShortId</th>
                <th>Redirect</th>
                <th>Clicks</th>
            </thead>
            <tbody>
                <% urls.forEach((url,index) => { %>
                   <TR>
                     <td><%= index+1 %></td>
                    <td><%= url.shortId %></td>
                    <td><%= url.redirectURL %></td>
                    <td><%= url.visitHistory.length %></td>
                   </TR>
                <% }) %>
            </tbody>
         </table>
        <% } %>
    </div>
</body>
</html>